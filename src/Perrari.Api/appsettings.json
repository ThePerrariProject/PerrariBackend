{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Perrari.Api",
    "Audience": "Perrari.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8,
    "TwoFactorTokenMinutes": 5
  }
}